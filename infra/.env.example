# infra/docker-compose.yml — SALIN ke infra/.env lalu isi nilainya.
# JANGAN PERNAH commit infra/.env (CLAUDE.md §6 aturan #15).
#
# Nilai di bawah hanyalah contoh bentuk, BUKAN kredensial yang boleh dipakai.
# Buat nilai acak, misalnya: openssl rand -base64 24

# ---------- MySQL (dipakai bersama oleh db_rbac, db_master, db_transaksi) ----------
MYSQL_ROOT_PASSWORD=GANTI_DENGAN_NILAI_ACAK
MYSQL_USER=beasiswa
MYSQL_PASSWORD=GANTI_DENGAN_NILAI_ACAK

# ---------- PostgreSQL (db_dokumen) ----------
POSTGRES_USER=beasiswa
POSTGRES_PASSWORD=GANTI_DENGAN_NILAI_ACAK

# ---------- Port yang dipublish ke host ----------
# HANYA dua ini. Service backend dan database tidak pernah dipublish.
GATEWAY_PORT=8080
FRONTEND_PORT=5173

# ---------- JWT ----------
JWT_ISSUER=beasiswa-rbac
JWT_AUDIENCE=beasiswa-app
# Generate outside the repository with ./infra/generate-jwt-keys.sh
JWT_PRIVATE_KEY_HOST=/absolute/path/to/private.pem
JWT_PUBLIC_KEY_HOST=/absolute/path/to/public.pem

# ---------- CORS ----------
# Whitelist origin frontend, pisahkan dengan koma. DILARANG "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Rate limit per menit ----------
RATE_LIMIT_UMUM_PER_MENIT=100
RATE_LIMIT_AUTH_PER_MENIT=10
RATE_LIMIT_UPLOAD_PER_MENIT=20

# ---------- Lain-lain ----------
LOG_LEVEL=info
MAIL_FROM=no-reply@beasiswa.local
APP_BASE_URL=http://localhost:5173
